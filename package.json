{
  "name": "macro",
  "version": "0.1.0",
  "private": true,
  "description": "Native Swift calorie tracking with a hosted OpenAI voice API.",
  "workspaces": [
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "setup:ios": "node scripts/setup-ios.mjs",
    "test:ios-project": "ruby scripts/test-ios-project.rb",
    "test:voice-config": "node --test scripts/local-proxy-address.test.mjs",
    "package:voice": "node scripts/package-voice.mjs",
    "ios": "node scripts/run-ios.mjs",
    "start:voice": "node scripts/voice-proxy.mjs start",
    "stop:voice": "node scripts/voice-proxy.mjs stop",
    "dev:voice": "npm run dev:voice -w @macro/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
